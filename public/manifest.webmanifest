{
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "name": "Editor — distraction-free writing",
  "short_name": "Editor",
  "description": "A distraction-free writing editor with a folder tree, nested files, inline images, full-text search, autosave, live word and character counts, and light or dark themes.",
  "background_color": "#faf7f0",
  "theme_color": "#f5f2ea",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
